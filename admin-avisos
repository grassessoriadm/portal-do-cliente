<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Painel Administrativo - Avisos | GR Assessoria</title>
    <link rel="icon" href="logo2.png" type="image/png">
    <style>
        *, *::before, *::after { margin:0; padding:0; box-sizing:border-box; }
        :root {
            --marsala:#6d213c; --marsala-dark:#4a1528; --marsala-light:#8a2e50;
            --burned-rose:#b36b7a; --burned-rose-light:#c98d99; --burned-rose-dark:#964f5e;
            --off-white:#fdfbf7; --off-white-dim:#f5f0e8;
            --bg-dark:#1a0e14; --bg-card:#2a1822; --bg-card-hover:#3a2230; --bg-input:#241420;
            --text-primary:#fdfbf7; --text-secondary:#c98d99; --text-muted:#8a6070;
            --border-subtle:rgba(179,107,122,0.15); --border-active:rgba(179,107,122,0.4);
            --shadow-glow:rgba(109,33,60,0.35);
            --font-primary:'Segoe UI','Helvetica Neue',Arial,sans-serif;
            --font-display:Georgia,'Times New Roman',serif;
            --radius-sm:8px; --radius-md:14px; --radius-lg:20px; --radius-full:50px;
            --success:#27ae60; --warning:#f0a830; --error:#e74c3c; --info:#3498db;
        }
        html { font-size:16px; }
        body { font-family:var(--font-primary); background:var(--bg-dark); color:var(--text-primary); min-height:100vh; -webkit-font-smoothing:antialiased; }

        @keyframes fadeIn { from{opacity:0;transform:translateY(10px)} to{opacity:1;transform:translateY(0)} }
        @keyframes scaleIn { from{opacity:0;transform:scale(0.96)} to{opacity:1;transform:scale(1)} }

        /* LOGIN DO ADMIN */
        #admin-login { display:flex; align-items:center; justify-content:center; min-height:100vh; }
        #admin-login.hidden { display:none; }
        .admin-login-card {
            background:linear-gradient(145deg,var(--bg-card),var(--marsala-dark));
            border:1px solid var(--border-subtle);
            border-radius:var(--radius-lg);
            padding:2.5rem; text-align:center;
            max-width:420px; width:90%;
            box-shadow:0 25px 60px rgba(0,0,0,0.4),0 0 80px var(--shadow-glow);
            animation:scaleIn 0.5s ease;
            position:relative; overflow:hidden;
        }
        .admin-login-card::before {
            content:''; position:absolute; top:0; left:0; right:0; height:3px;
            background:linear-gradient(90deg,transparent,var(--burned-rose),var(--marsala-light),var(--burned-rose),transparent);
        }
        .admin-login-title { font-family:var(--font-display); font-size:1.2rem; color:var(--off-white); margin-bottom:0.3rem; }
        .admin-login-sub { font-size:0.72rem; color:var(--text-secondary); letter-spacing:2px; text-transform:uppercase; margin-bottom:2rem; }
        .admin-input {
            width:100%; padding:14px 18px; background:var(--bg-input);
            border:1.5px solid var(--border-subtle); border-radius:var(--radius-sm);
            color:var(--text-primary); font-size:1rem; font-family:var(--font-primary);
            outline:none; transition:all 0.3s ease; margin-bottom:1rem;
        }
        .admin-input:focus { border-color:var(--burned-rose); box-shadow:0 0 0 3px rgba(179,107,122,0.15); }
        .admin-btn {
            width:100%; padding:14px; background:linear-gradient(135deg,var(--marsala),var(--marsala-light));
            border:none; border-radius:var(--radius-full); color:var(--off-white);
            font-size:0.9rem; font-weight:600; letter-spacing:1px; text-transform:uppercase;
            cursor:pointer; transition:all 0.3s ease;
        }
        .admin-btn:hover { background:linear-gradient(135deg,var(--marsala-light),var(--burned-rose-dark)); box-shadow:0 8px 30px rgba(109,33,60,0.5); transform:translateY(-1px); }
        .admin-login-error { display:none; color:#e88; font-size:0.85rem; margin-top:0.5rem; }
        .admin-login-error.visible { display:block; animation:fadeIn 0.3s ease; }

        /* PAINEL ADMIN */
        #admin-panel { display:none; min-height:100vh; }
        #admin-panel.visible { display:block; }
        .admin-header {
            background:linear-gradient(180deg,rgba(26,14,20,0.97),rgba(26,14,20,0.85));
            backdrop-filter:blur(12px); -webkit-backdrop-filter:blur(12px);
            border-bottom:1px solid var(--border-subtle);
            padding:0.8rem 2rem; display:flex; align-items:center; justify-content:space-between;
            position:sticky; top:0; z-index:50;
        }
        .admin-header-brand { display:flex; align-items:center; gap:12px; }
        .admin-header-brand h1 { font-family:var(--font-display); font-size:1rem; color:var(--off-white); }
        .admin-header-brand span { font-size:0.65rem; color:var(--text-muted); letter-spacing:1.5px; text-transform:uppercase; }
        .admin-logout {
            padding:8px 18px; background:rgba(109,33,60,0.2); border:1px solid var(--border-subtle);
            border-radius:var(--radius-full); color:var(--text-secondary); font-size:0.8rem;
            cursor:pointer; transition:all 0.3s ease;
        }
        .admin-logout:hover { background:rgba(109,33,60,0.4); color:var(--off-white); }

        .admin-content { max-width:900px; margin:0 auto; padding:2rem 1rem 3rem; animation:fadeIn 0.5s ease; }
        .admin-section-title { font-family:var(--font-display); font-size:1.3rem; color:var(--off-white); margin-bottom:1.5rem; }

        /* FORM DE AVISO */
        .admin-form-card {
            background:var(--bg-card); border:1px solid var(--border-subtle);
            border-radius:var(--radius-md); padding:1.5rem; margin-bottom:1.5rem;
        }
        .admin-form-row { display:flex; gap:1rem; margin-bottom:1rem; flex-wrap:wrap; }
        .admin-form-group { flex:1; min-width:200px; }
        .admin-form-group.full { flex:100%; }
        .admin-label { display:block; font-size:0.78rem; color:var(--text-secondary); margin-bottom:0.4rem; text-transform:uppercase; letter-spacing:1px; }
        .admin-field {
            width:100%; padding:12px 14px; background:var(--bg-input);
            border:1.5px solid var(--border-subtle); border-radius:var(--radius-sm);
            color:var(--text-primary); font-size:0.9rem; font-family:var(--font-primary);
            outline:none; transition:all 0.3s ease;
        }
        .admin-field:focus { border-color:var(--burned-rose); box-shadow:0 0 0 3px rgba(179,107,122,0.1); }
        textarea.admin-field { resize:vertical; min-height:100px; line-height:1.5; }
        select.admin-field { cursor:pointer; }
        .admin-form-actions { display:flex; gap:0.8rem; margin-top:1rem; }
        .admin-btn-sm {
            padding:10px 22px; border:none; border-radius:var(--radius-full);
            font-size:0.82rem; font-weight:600; cursor:pointer; transition:all 0.3s ease;
            font-family:var(--font-primary);
        }
        .admin-btn-primary { background:linear-gradient(135deg,var(--marsala),var(--marsala-light)); color:var(--off-white); }
        .admin-btn-primary:hover { background:linear-gradient(135deg,var(--marsala-light),var(--burned-rose-dark)); transform:translateY(-1px); }
        .admin-btn-secondary { background:rgba(255,255,255,0.08); color:var(--text-secondary); border:1px solid var(--border-subtle); }
        .admin-btn-secondary:hover { background:rgba(255,255,255,0.15); color:var(--off-white); }
        .admin-btn-danger { background:rgba(231,76,60,0.15); color:#e88; border:1px solid rgba(231,76,60,0.3); }
        .admin-btn-danger:hover { background:rgba(231,76,60,0.3); }

        /* LISTA DE AVISOS */
        .admin-aviso-item {
            background:var(--bg-card); border:1px solid var(--border-subtle);
            border-radius:var(--radius-md); padding:1.2rem; margin-bottom:0.8rem;
            transition:all 0.3s ease; animation:fadeIn 0.4s ease;
        }
        .admin-aviso-item:hover { border-color:var(--border-active); background:var(--bg-card-hover); }
        .admin-aviso-item-header { display:flex; justify-content:space-between; align-items:start; gap:1rem; margin-bottom:0.5rem; flex-wrap:wrap; }
        .admin-aviso-item-title { font-size:1rem; color:var(--off-white); font-weight:600; }
        .admin-aviso-item-meta { display:flex; gap:0.5rem; flex-wrap:wrap; align-items:center; }
        .admin-badge { padding:3px 10px; border-radius:var(--radius-full); font-size:0.68rem; font-weight:600; text-transform:uppercase; letter-spacing:0.5px; }
        .admin-badge-active { background:rgba(39,174,96,0.2); color:#2ecc71; border:1px solid rgba(39,174,96,0.3); }
        .admin-badge-inactive { background:rgba(255,255,255,0.08); color:var(--text-muted); border:1px solid var(--border-subtle); }
        .admin-badge-viewed { background:rgba(52,152,219,0.2); color:#5dade2; border:1px solid rgba(52,152,219,0.3); }
        .admin-badge-pending { background:rgba(240,168,48,0.2); color:#f0c060; border:1px solid rgba(240,168,48,0.3); }
        .admin-badge-type { padding:3px 10px; border-radius:var(--radius-full); font-size:0.68rem; font-weight:600; }
        .admin-badge-type-info { background:rgba(52,152,219,0.15); color:#5dade2; }
        .admin-badge-type-urgente { background:rgba(231,76,60,0.15); color:#e74c3c; }
        .admin-badge-type-atencao { background:rgba(240,168,48,0.15); color:#f0c060; }
        .admin-badge-type-sucesso { background:rgba(39,174,96,0.15); color:#2ecc71; }
        .admin-aviso-item-cliente { font-size:0.82rem; color:var(--text-secondary); margin-bottom:0.3rem; }
        .admin-aviso-item-msg { font-size:0.85rem; color:var(--text-muted); line-height:1.5; white-space:pre-line; margin-bottom:0.8rem; }
        .admin-aviso-item-actions { display:flex; gap:0.5rem; flex-wrap:wrap; }
        .admin-aviso-item-actions button { padding:6px 16px; font-size:0.76rem; }
        .admin-empty { text-align:center; color:var(--text-muted); padding:2rem; font-size:0.9rem; }

        /* TOGGLE SWITCH */
        .admin-toggle { position:relative; display:inline-block; width:44px; height:24px; }
        .admin-toggle input { opacity:0; width:0; height:0; }
        .admin-toggle-slider {
            position:absolute; cursor:pointer; top:0; left:0; right:0; bottom:0;
            background:rgba(255,255,255,0.1); border-radius:24px; transition:0.3s;
        }
        .admin-toggle-slider::before {
            content:''; position:absolute; height:18px; width:18px; left:3px; bottom:3px;
            background:var(--text-muted); border-radius:50%; transition:0.3s;
        }
        .admin-toggle input:checked + .admin-toggle-slider { background:rgba(109,33,60,0.4); }
        .admin-toggle input:checked + .admin-toggle-slider::before { transform:translateX(20px); background:var(--marsala-light); }

        .admin-filter-bar { display:flex; gap:0.8rem; margin-bottom:1.5rem; flex-wrap:wrap; align-items:center; }
        .admin-filter-bar select { max-width:200px; }

        @media(max-width:768px){
            .admin-header{padding:0.5rem 1rem}
            .admin-content{padding:1rem 0.5rem 2rem}
            .admin-form-row{flex-direction:column}
            .admin-form-group{min-width:100%}
            .admin-login-card{padding:1.8rem 1.5rem}
        }
    </style>
</head>
<body>

<!-- TELA DE LOGIN DO ADMIN -->
<div id="admin-login">
    <div class="admin-login-card">
        <h2 class="admin-login-title">Painel Administrativo</h2>
        <p class="admin-login-sub">GR Assessoria - Avisos</p>
        <input type="password" class="admin-input" id="admin-senha" placeholder="Digite a senha de administração" autofocus>
        <button class="admin-btn" id="admin-login-btn">Entrar</button>
        <p class="admin-login-error" id="admin-login-error">Senha incorreta. Tente novamente.</p>
    </div>
</div>

<!-- PAINEL ADMIN -->
<div id="admin-panel">
    <header class="admin-header">
        <div class="admin-header-brand">
            <h1>Gerenciamento de Avisos</h1>
            <span>GR Assessoria</span>
        </div>
        <button class="admin-logout" id="admin-logout-btn">Sair</button>
    </header>

    <div class="admin-content">
        <h2 class="admin-section-title">Cadastrar Novo Aviso</h2>
        <div class="admin-form-card">
            <form id="form-aviso">
                <input type="hidden" id="aviso-id">
                <div class="admin-form-row">
                    <div class="admin-form-group">
                        <label class="admin-label">Cliente</label>
                        <select class="admin-field" id="aviso-cliente" required>
                            <option value="">Selecione o cliente...</option>
                        </select>
                    </div>
                    <div class="admin-form-group">
                        <label class="admin-label">Tipo de Aviso</label>
                        <select class="admin-field" id="aviso-tipo">
                            <option value="info">Informação</option>
                            <option value="urgente">Urgente</option>
                            <option value="atencao">Atenção</option>
                            <option value="sucesso">Sucesso</option>
                        </select>
                    </div>
                </div>
                <div class="admin-form-row">
                    <div class="admin-form-group full">
                        <label class="admin-label">Título do Aviso</label>
                        <input type="text" class="admin-field" id="aviso-titulo" placeholder="Ex: Informação Importante" required>
                    </div>
                </div>
                <div class="admin-form-row">
                    <div class="admin-form-group full">
                        <label class="admin-label">Mensagem</label>
                        <textarea class="admin-field" id="aviso-mensagem" placeholder="Digite a mensagem que o cliente verá..." required></textarea>
                    </div>
                </div>
                <div class="admin-form-row">
                    <div class="admin-form-group">
                        <label class="admin-label">Modo de Exibição</label>
                        <select class="admin-field" id="aviso-modo">
                            <option value="ate_confirmar">Mostrar até confirmar (padrão)</option>
                            <option value="uma_vez">Mostrar apenas uma vez</option>
                            <option value="sempre_pendente">Mostrar enquanto pendente</option>
                        </select>
                    </div>
                    <div class="admin-form-group">
                        <label class="admin-label">Ativo</label>
                        <div style="padding-top:8px;">
                            <label class="admin-toggle">
                                <input type="checkbox" id="aviso-ativo" checked>
                                <span class="admin-toggle-slider"></span>
                            </label>
                        </div>
                    </div>
                </div>
                <div class="admin-form-actions">
                    <button type="submit" class="admin-btn-sm admin-btn-primary" id="btn-salvar">Salvar Aviso</button>
                    <button type="button" class="admin-btn-sm admin-btn-secondary" id="btn-cancelar" style="display:none;">Cancelar</button>
                </div>
            </form>
        </div>

        <h2 class="admin-section-title">Avisos Cadastrados</h2>
        <div class="admin-filter-bar">
            <select class="admin-field" id="filtro-cliente">
                <option value="">Todos os clientes</option>
            </select>
            <select class="admin-field" id="filtro-status">
                <option value="">Todos os status</option>
                <option value="ativo">Apenas ativos</option>
                <option value="inativo">Apenas inativos</option>
                <option value="pendente">Pendentes (não visualizados)</option>
                <option value="visualizado">Já visualizados</option>
            </select>
        </div>
        <div id="lista-avisos"></div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script>
    /* ============================================================
       CONFIGURAÇÃO
       ============================================================ */
    const GR_SUPABASE_URL = 'https://zmnjqicsejcyvntxqyql.supabase.co';
    const GR_SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InptbmpxaWNzZWpjeXZudHhxeXFsIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTE5OTI5MzIsImV4cCI6MjEwNzU2ODkzMn0.GZsgbms7JYhrh0l3x2x5A8VxKMDbY57idclXbgf6hBo';

    /* SENHA DO ADMINISTRADOR — altere aqui */
    const ADMIN_SENHA = 'gradmin2026';

    /* Lista de clientes (mesma do portal) */
    const bancoClientes = {
        "1721": "Alisson Elias de Souza",
        "BLOckED1298": "Glazielen Lourenço da Silva",
        "4490": "Marco Antonio da Silva Oliveira",
        "2834": "Givanilda Maria de Lemos",
        "1626": "Gabrielle Macedo dos Santos Rocha",
        "3002": "Josefa Macedo dos Santos"
    };

    const sb = window.supabase.createClient(GR_SUPABASE_URL, GR_SUPABASE_KEY);

    /* ============================================================
       AUTENTICAÇÃO DO ADMIN
       ============================================================ */
    const adminLogin = document.getElementById('admin-login');
    const adminPanel = document.getElementById('admin-panel');
    const adminSenha = document.getElementById('admin-senha');
    const adminLoginBtn = document.getElementById('admin-login-btn');
    const adminLoginError = document.getElementById('admin-login-error');
    const adminLogoutBtn = document.getElementById('admin-logout-btn');

    function verificarAdmin() {
        if (sessionStorage.getItem('grAdminLogado') === 'true') {
            adminLogin.classList.add('hidden');
            adminPanel.classList.add('visible');
            iniciarPainel();
        }
    }

    adminLoginBtn.addEventListener('click', () => {
        if (adminSenha.value === ADMIN_SENHA) {
            sessionStorage.setItem('grAdminLogado', 'true');
            adminLogin.classList.add('hidden');
            adminPanel.classList.add('visible');
            iniciarPainel();
        } else {
            adminLoginError.classList.add('visible');
            adminSenha.value = '';
            setTimeout(() => adminLoginError.classList.remove('visible'), 3000);
        }
    });

    adminSenha.addEventListener('keydown', (e) => {
        if (e.key === 'Enter') adminLoginBtn.click();
    });

    adminLogoutBtn.addEventListener('click', () => {
        sessionStorage.removeItem('grAdminLogado');
        adminPanel.classList.remove('visible');
        adminLogin.classList.remove('hidden');
        adminSenha.value = '';
        adminSenha.focus();
    });

    /* ============================================================
       PREENCHER SELECT DE CLIENTES
       ============================================================ */
    function preencherClientes() {
        const selCliente = document.getElementById('aviso-cliente');
        const selFiltro = document.getElementById('filtro-cliente');
        for (const [id, nome] of Object.entries(bancoClientes)) {
            const opt1 = document.createElement('option');
            opt1.value = id;
            opt1.textContent = id + ' - ' + nome;
            selCliente.appendChild(opt1);

            const opt2 = document.createElement('option');
            opt2.value = id;
            opt2.textContent = id + ' - ' + nome;
            selFiltro.appendChild(opt2);
        }
    }

    /* ============================================================
       CARREGAR E LISTAR AVISOS
       ============================================================ */
    async function carregarAvisos() {
        const filtroCliente = document.getElementById('filtro-cliente').value;
        const filtroStatus = document.getElementById('filtro-status').value;
        const lista = document.getElementById('lista-avisos');

        let query = sb.from('avisos').select('*').order('created_at', { ascending: false });
        if (filtroCliente) query = query.eq('cliente_id', filtroCliente);

        const { data, error } = await query;
        if (error || !data) {
            lista.innerHTML = '<p class="admin-empty">Erro ao carregar avisos.</p>';
            return;
        }

        let filtrados = data;
        if (filtroStatus === 'ativo') filtrados = data.filter(a => a.ativo);
        else if (filtroStatus === 'inativo') filtrados = data.filter(a => !a.ativo);
        else if (filtroStatus === 'pendente') filtrados = data.filter(a => !a.visualizado);
        else if (filtroStatus === 'visualizado') filtrados = data.filter(a => a.visualizado);

        if (filtrados.length === 0) {
            lista.innerHTML = '<p class="admin-empty">Nenhum aviso cadastrado.</p>';
            return;
        }

        lista.innerHTML = '';
        filtrados.forEach(a => {
            const nomeCliente = bancoClientes[a.cliente_id] || a.cliente_id;
            const tipoLabels = { info: 'Informação', urgente: 'Urgente', atencao: 'Atenção', sucesso: 'Sucesso' };
            const tipoLabel = tipoLabels[a.tipo] || 'Info';
            const modoLabels = { 'ate_confirmar': 'Até confirmar', 'uma_vez': 'Uma vez', 'sempre_pendente': 'Sempre pendente' };
            const modoLabel = modoLabels[a.modo_exibicao] || 'Até confirmar';
            const dataFmt = new Date(a.created_at).toLocaleString('pt-BR', { day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit' });

            const item = document.createElement('div');
            item.className = 'admin-aviso-item';
            item.innerHTML = `
                <div class="admin-aviso-item-header">
                    <div>
                        <div class="admin-aviso-item-title">${escaparHtml(a.titulo)}</div>
                        <div class="admin-aviso-item-cliente">Cliente: ${escaparHtml(a.cliente_id)} - ${escaparHtml(nomeCliente)}</div>
                    </div>
                    <div class="admin-aviso-item-meta">
                        <span class="admin-badge admin-badge-type-${a.tipo}">${tipoLabel}</span>
                        <span class="admin-badge ${a.ativo ? 'admin-badge-active' : 'admin-badge-inactive'}">${a.ativo ? 'Ativo' : 'Inativo'}</span>
                        <span class="admin-badge ${a.visualizado ? 'admin-badge-viewed' : 'admin-badge-pending'}">${a.visualizado ? 'Visualizado' : 'Pendente'}</span>
                    </div>
                </div>
                <div class="admin-aviso-item-msg">${escaparHtml(a.mensagem)}</div>
                <div style="font-size:0.72rem; color:var(--text-muted); margin-bottom:0.6rem;">Criado em: ${dataFmt} | Modo: ${modoLabel}</div>
                <div class="admin-aviso-item-actions">
                    <button class="admin-btn-sm admin-btn-secondary" onclick="editarAviso('${a.id}')">Editar</button>
                    <button class="admin-btn-sm admin-btn-secondary" onclick="toggleAtivo('${a.id}', ${!a.ativo})">${a.ativo ? 'Desativar' : 'Ativar'}</button>
                    <button class="admin-btn-sm admin-btn-secondary" onclick="marcarPendente('${a.id}')">Marcar pendente</button>
                    <button class="admin-btn-sm admin-btn-danger" onclick="excluirAviso('${a.id}')">Excluir</button>
                </div>
            `;
            lista.appendChild(item);
        });
    }

    function escaparHtml(texto) {
        if (!texto) return '';
        const div = document.createElement('div');
        div.textContent = texto;
        return div.innerHTML;
    }

    /* ============================================================
       FORM - SALVAR/EDITAR AVISO
       ============================================================ */
    const formAviso = document.getElementById('form-aviso');
    const btnSalvar = document.getElementById('btn-salvar');
    const btnCancelar = document.getElementById('btn-cancelar');

    formAviso.addEventListener('submit', async (e) => {
        e.preventDefault();
        const id = document.getElementById('aviso-id').value;
        const dados = {
            cliente_id: document.getElementById('aviso-cliente').value,
            titulo: document.getElementById('aviso-titulo').value,
            mensagem: document.getElementById('aviso-mensagem').value,
            tipo: document.getElementById('aviso-tipo').value,
            modo_exibicao: document.getElementById('aviso-modo').value,
            ativo: document.getElementById('aviso-ativo').checked
        };

        if (!dados.cliente_id) { alert('Selecione um cliente.'); return; }

        if (id) {
            await sb.from('avisos').update(dados).eq('id', id);
        } else {
            dados.visualizado = false;
            await sb.from('avisos').insert(dados);
        }

        limparForm();
        carregarAvisos();
    });

    btnCancelar.addEventListener('click', () => limparForm());

    function limparForm() {
        document.getElementById('aviso-id').value = '';
        document.getElementById('aviso-cliente').value = '';
        document.getElementById('aviso-titulo').value = '';
        document.getElementById('aviso-mensagem').value = '';
        document.getElementById('aviso-tipo').value = 'info';
        document.getElementById('aviso-modo').value = 'ate_confirmar';
        document.getElementById('aviso-ativo').checked = true;
        btnSalvar.textContent = 'Salvar Aviso';
        btnCancelar.style.display = 'none';
    }

    /* ============================================================
       AÇÕES NOS AVISOS
       ============================================================ */
    window.editarAviso = async function(id) {
        const { data, error } = await sb.from('avisos').select('*').eq('id', id).maybeSingle();
        if (error || !data) return;
        document.getElementById('aviso-id').value = data.id;
        document.getElementById('aviso-cliente').value = data.cliente_id;
        document.getElementById('aviso-titulo').value = data.titulo;
        document.getElementById('aviso-mensagem').value = data.mensagem;
        document.getElementById('aviso-tipo').value = data.tipo;
        document.getElementById('aviso-modo').value = data.modo_exibicao;
        document.getElementById('aviso-ativo').checked = data.ativo;
        btnSalvar.textContent = 'Atualizar Aviso';
        btnCancelar.style.display = 'inline-block';
        window.scrollTo({ top: 0, behavior: 'smooth' });
    };

    window.toggleAtivo = async function(id, novoValor) {
        await sb.from('avisos').update({ ativo: novoValor }).eq('id', id);
        carregarAvisos();
    };

    window.marcarPendente = async function(id) {
        await sb.from('avisos').update({ visualizado: false, visualizado_em: null }).eq('id', id);
        carregarAvisos();
    };

    window.excluirAviso = async function(id) {
        if (!confirm('Tem certeza que deseja excluir este aviso?')) return;
        await sb.from('avisos').delete().eq('id', id);
        carregarAvisos();
    };

    /* ============================================================
       FILTROS
       ============================================================ */
    document.getElementById('filtro-cliente').addEventListener('change', carregarAvisos);
    document.getElementById('filtro-status').addEventListener('change', carregarAvisos);

    /* ============================================================
       INICIALIZAÇÃO
       ============================================================ */
    function iniciarPainel() {
        preencherClientes();
        carregarAvisos();
    }

    verificarAdmin();
</script>
</body>
</html>
